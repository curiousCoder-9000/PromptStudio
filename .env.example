# PromptStudio — copy to `.env` and fill in your values.
# Never commit `.env` (it is gitignored).

# ── Server ───────────────────────────────────────────────────────
PROMPTSTUDIO_HOST=
PROMPTSTUDIO_PORT=5000
# Gallery page size
PROMPTSTUDIO_PHOTO_PAGE=300
PROMPTSTUDIO_THUMB_SIZE=400
# Force full reindex of the archive on next start: 1/true
PROMPTSTUDIO_REBUILD_INDEX=

# ── Local media archive (photos/videos live HERE, not in git) ────
# Windows example: C:\Users\YOU\Pictures\InstagramSaved
# macOS/Linux example: ~/Pictures/InstagramSaved
PROMPTSTUDIO_ARCHIVE=~/Pictures/InstagramSaved

# ── Trash (soft delete) ──────────────────────────────────────────
# 1 = UI deletes move media to <archive>/_trash/ and can be restored.
# 0 = delete unlinks immediately (no undo).
PROMPTSTUDIO_TRASH=1
# Age in days used by "Purge expired" in the Trash modal (0 disables)
PROMPTSTUDIO_TRASH_DAYS=30

# ── Instagram / Instaloader ──────────────────────────────────────
# Your Instagram username (session file: session-<username>)
INSTAGRAM_SESSION_USER=
# Where Instaloader stores session files
# Windows default: ~/AppData/Local/Instaloader
# macOS/Linux: often ~/.config/instaloader
INSTALOADER_SESSION_DIR=~/AppData/Local/Instaloader

# Create a session once (outside this app):
#   pip install instaloader
#   instaloader --login YOUR_USERNAME
# Then set INSTAGRAM_SESSION_USER=YOUR_USERNAME

# ── Ollama vision / rewrite ─────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
# Optional separate text endpoint (defaults to OLLAMA_URL)
# OLLAMA_TEXT_URL=http://localhost:11434/api/generate
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_REWRITE_MODEL=qwen2.5vl:7b

# Prompt tone for image → SD/Flux prompts:
#   balanced  — photorealistic portrait / fashion (default, public-safe)
#   high      — more sensual / body-focused rewrite (private use)
#   low       — conservative, clothing/scene focused
PROMPT_INTENSITY=balanced
# Prefer realistic anatomy wording: strong | mild | off
PROMPT_REALISM_BIAS=strong
PROMPT_HISTORY_MAX=3
CREATOR_STYLE_MIN=5

# ── ComfyUI (optional local image gen) ───────────────────────────
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=juggernautXL_ragnarok.safetensors
# COMFYUI_PRO_WORKFLOW=   # absolute path override
COMFYUI_DENOISE=0.70
COMFYUI_STEPS=32
COMFYUI_CFG=6.0

# ── Instagram scrape pacing (anti-ban) ───────────────────────────
IG_DOWNLOAD_DELAY=2.5
IG_POST_DELAY_MIN=4
IG_POST_DELAY_MAX=12
IG_ACCOUNT_PAUSE_MIN=30
IG_ACCOUNT_PAUSE_MAX=120
IG_BATCH_EVERY=10
IG_BATCH_PAUSE_MIN=300
IG_BATCH_PAUSE_MAX=900
IG_ABORT_RATE_LIMIT_STREAK=3
IG_CATCH_UP_STREAK=3
IG_ACCOUNTS_PER_DAY=20
IG_RATE_LIMIT_BACKOFF=60
IG_RATE_LIMIT_BACKOFF_MAX=300
IG_MAX_POSTS=50
IG_MIN_MEDIA_COUNT=5
IG_INCLUDE_VIDEOS=1
IG_FULL_SCRAPE_MAX_POSTS=5000
IG_SCRAPE_HISTORY_MAX=50
IG_SCRAPE_MAX_PENDING=50
IG_CREATOR_SCRAPE_QUEUE=1
IG_AUTO_DRAIN_ON_START=1
IG_AUTO_DRAIN_DELAY_SEC=2
IG_POST_RANK=1
IG_POST_SCAN_FACTOR=3
IG_QUEUE_PRIORITY_DEFAULT=10

# Caption/bio keyword filters for ranking (comma-separated).
# Defaults are fashion/model oriented; customize for your taste.
IG_CAPTION_KEYWORDS=model,fashion,beauty,portrait,style,fitness,cosplay,editorial,swimwear,runway,glamour
IG_BIO_KEYWORDS=model,influencer,fitness,glamour,actress,swimwear,cosplay,fashion,beauty,photographer

# ── Run journal (append-only history of background jobs) ─────────
# <archive>/_journal/<kind>.jsonl — read via GET /api/journal?kind=sync
PROMPTSTUDIO_JOURNAL=1
PROMPTSTUDIO_JOURNAL_MAX_BYTES=10485760
PROMPTSTUDIO_JOURNAL_BACKUPS=3

# FTS5 prompt search. Off by default — measured slower than the LIKE scan for
# common query terms at current archive sizes (docs/review_backend_architecture.md
# S5 has the numbers). The index is maintained regardless, so this is a flip.
PROMPTSTUDIO_FTS_SEARCH=0

# ── Logging ──────────────────────────────────────────────────────
PROMPTSTUDIO_LOG_LEVEL=INFO
# Defaults to <archive>/promptstudio.log. Empty string disables file logging.
#PROMPTSTUDIO_LOG_FILE=
PROMPTSTUDIO_LOG_MAX_BYTES=5242880
PROMPTSTUDIO_LOG_BACKUPS=3
PROMPTSTUDIO_LOG_CONSOLE=1

# ── Media keep/reject classifier ─────────────────────────────────
# Per-creator vision pass that tags every photo and reel with a 0-4 exposure
# tier, then derives keep/reject from it. Runs on the same Ollama vision model
# as prompts (OLLAMA_VISION_MODEL) and holds the same exclusive lease, so it
# cannot run alongside a batch analyze.
CLASSIFY_MAX_EDGE=768
# Contact sheets carry 9 panels and need a larger edge than a single frame.
CLASSIFY_SHEET_MAX_EDGE=1368
CLASSIFY_NUM_CTX=8192
CLASSIFY_NUM_PREDICT=400
CLASSIFY_TIMEOUT=180
CLASSIFY_RETRIES=2
CLASSIFY_KEEP_ALIVE=30m
# JSON-schema constrained decoding. 0 falls back to scraping JSON out of prose.
CLASSIFY_STRUCTURED=1
# Tiers 0..N are rejects. The tier is persisted, so changing this re-thresholds
# the archive instantly — no re-classify. 1 = discard unusable AND fully modest;
# 0 = cleanup only (no woman / man in frame / poster / blur).
CLASSIFY_REJECT_MAX_TIER=1
# Whole-reel contact sheet: one vision call sees the entire timeline, so a
# reveal in the final seconds is judged. 0 = rank frames and score the best.
CLASSIFY_REEL_SHEET=1
# Vision calls one reel may spend: the sheet, plus at most one confirm re-read.
CLASSIFY_REEL_VISION_MAX=2
# Confidence band that triggers the confirm re-read at full resolution.
CLASSIFY_REEL_UNCERTAIN_LO=0.45
CLASSIFY_REEL_UNCERTAIN_HI=0.65

# ── Video frame selection ────────────────────────────────────────
# Shared by the classifier, video thumbnails and near-duplicate detection.
# TAIL_FRAC=0 is load-bearing: the interesting frame is often in the last
# seconds, and the old 0.06 skipped exactly that.
CLASSIFY_REEL_CANDIDATES=16
CLASSIFY_REEL_SKIP_HEAD_FRAC=0.02
CLASSIFY_REEL_SKIP_TAIL_FRAC=0.0
CLASSIFY_REEL_MIN_BRIGHT=22
CLASSIFY_REEL_MIN_SHARP=35
# Sharpness at/above this stops earning rank, so an adequately sharp frame is
# not beaten by a razor-sharp static intro.
CLASSIFY_REEL_SHARP_REF=140
# Contact-sheet geometry (also used by dedupe sampling).
CLASSIFY_REEL_SHEET_PANELS=9
CLASSIFY_REEL_SHEET_PANEL_W=256
# Skin-tone fraction weight in the frame ranker. 0 disables the term.
CLASSIFY_REEL_SKIN_WEIGHT=1.0
# HSV histogram correlation below this between samples counts as a shot cut.
CLASSIFY_REEL_CUT_THRESHOLD=0.45

# ── Multi-source scraping: X / Reddit (gallery-dl) ───────────────
# Requires: pip install gallery-dl   (driven as a subprocess)

# Archive folders stay one level deep, so non-Instagram sources are
# disambiguated by folder suffix: nina -> nina__x, r/fashion -> r_fashion__reddit.
# Instagram keeps bare handles, so your existing archive is untouched.
# Set to 0 only if you want X media merged into the Instagram creator folder.
SCRAPE_FOLDER_SUFFIX=1
SCRAPE_FOLDER_SUFFIX_SEP=__

GALLERY_DL_BIN=gallery-dl
GALLERY_DL_TIMEOUT=7200
# Extra raw gallery-dl args (whitespace-split) — per-site escape hatch.
GALLERY_DL_EXTRA_ARGS=

# Cookies. X requires them; Reddit works without. Netscape cookies.txt format.
# NEVER commit these files. Use a throwaway account, not your primary — X's ToS
# prohibits automated collection and accounts do get suspended.
X_COOKIES_FILE=
REDDIT_COOKIES_FILE=
# Or read cookies straight from a browser profile: firefox | chrome:Default
SCRAPE_COOKIES_FROM_BROWSER=

# Pacing (seconds). Deliberately gentler than gallery-dl's own defaults.
SCRAPE_SLEEP=2.0
SCRAPE_SLEEP_REQUEST=1.5
SCRAPE_SLEEP_429=90
SCRAPE_RETRIES=3
# Catch-up: stop after N consecutive already-downloaded files (0 = use IG_CATCH_UP_STREAK)
SCRAPE_ABORT_AFTER_KNOWN=0

# X: pull /media timeline only (photos+videos, no text-only tweets)
X_MEDIA_TIMELINE_ONLY=1
X_INCLUDE_RETWEETS=0
