# PromptStudio — copy to `.env` and fill in your values.
# Never commit `.env` (it is gitignored).

# ── Server ───────────────────────────────────────────────────────
PROMPTSTUDIO_HOST=
PROMPTSTUDIO_PORT=5000
# Gallery page size
PROMPTSTUDIO_PHOTO_PAGE=300
PROMPTSTUDIO_THUMB_SIZE=400
# Force full reindex of the archive on next start: 1/true
PROMPTSTUDIO_REBUILD_INDEX=

# ── Local media archive (photos/videos live HERE, not in git) ────
# Windows example: C:\Users\YOU\Pictures\InstagramSaved
# macOS/Linux example: ~/Pictures/InstagramSaved
PROMPTSTUDIO_ARCHIVE=~/Pictures/InstagramSaved

# ── Instagram / Instaloader ──────────────────────────────────────
# Your Instagram username (session file: session-<username>)
INSTAGRAM_SESSION_USER=
# Where Instaloader stores session files
# Windows default: ~/AppData/Local/Instaloader
# macOS/Linux: often ~/.config/instaloader
INSTALOADER_SESSION_DIR=~/AppData/Local/Instaloader

# Create a session once (outside this app):
#   pip install instaloader
#   instaloader --login YOUR_USERNAME
# Then set INSTAGRAM_SESSION_USER=YOUR_USERNAME

# ── Ollama vision / rewrite ─────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
# Optional separate text endpoint (defaults to OLLAMA_URL)
# OLLAMA_TEXT_URL=http://localhost:11434/api/generate
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_REWRITE_MODEL=qwen2.5vl:7b

# Prompt tone for image → SD/Flux prompts:
#   balanced  — photorealistic portrait / fashion (default, public-safe)
#   high      — more sensual / body-focused rewrite (private use)
#   low       — conservative, clothing/scene focused
PROMPT_INTENSITY=balanced
# Prefer realistic anatomy wording: strong | mild | off
PROMPT_REALISM_BIAS=strong
PROMPT_HISTORY_MAX=3
CREATOR_STYLE_MIN=5

# ── ComfyUI (optional local image gen) ───────────────────────────
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=juggernautXL_ragnarok.safetensors
# COMFYUI_PRO_WORKFLOW=   # absolute path override
COMFYUI_DENOISE=0.70
COMFYUI_STEPS=32
COMFYUI_CFG=6.0

# ── Instagram scrape pacing (anti-ban) ───────────────────────────
IG_DOWNLOAD_DELAY=2.5
IG_POST_DELAY_MIN=4
IG_POST_DELAY_MAX=12
IG_ACCOUNT_PAUSE_MIN=30
IG_ACCOUNT_PAUSE_MAX=120
IG_BATCH_EVERY=10
IG_BATCH_PAUSE_MIN=300
IG_BATCH_PAUSE_MAX=900
IG_ABORT_RATE_LIMIT_STREAK=3
IG_CATCH_UP_STREAK=3
IG_ACCOUNTS_PER_DAY=20
IG_RATE_LIMIT_BACKOFF=60
IG_RATE_LIMIT_BACKOFF_MAX=300
IG_MAX_POSTS=50
IG_MIN_MEDIA_COUNT=5
IG_INCLUDE_VIDEOS=1
IG_FULL_SCRAPE_MAX_POSTS=5000
IG_SCRAPE_HISTORY_MAX=50
IG_SCRAPE_MAX_PENDING=50
IG_CREATOR_SCRAPE_QUEUE=1
IG_AUTO_DRAIN_ON_START=1
IG_AUTO_DRAIN_DELAY_SEC=2
IG_POST_RANK=1
IG_POST_SCAN_FACTOR=3
IG_QUEUE_PRIORITY_KEEP=100
IG_QUEUE_PRIORITY_UNSURE=40
IG_QUEUE_PRIORITY_DEFAULT=10

# Caption/bio keyword filters for ranking (comma-separated).
# Defaults are fashion/model oriented; customize for your taste.
IG_CAPTION_KEYWORDS=model,fashion,beauty,portrait,style,fitness,cosplay,editorial,swimwear,runway,glamour
IG_BIO_KEYWORDS=model,influencer,fitness,glamour,actress,swimwear,cosplay,fashion,beauty,photographer

# Gallery "glam/sexy" filter threshold (0–3)
GLAM_SEXY_MIN=2

# ── Reel / photo glam classifier (Ollama) ────────────────────────
CLASSIFY_MAX_EDGE=768
CLASSIFY_REEL_CANDIDATES=10
CLASSIFY_REEL_VISION_MAX=1
CLASSIFY_REEL_SKIP_HEAD_FRAC=0.08
CLASSIFY_REEL_SKIP_TAIL_FRAC=0.06
CLASSIFY_REEL_MIN_BRIGHT=22
CLASSIFY_REEL_MIN_SHARP=35
CLASSIFY_REEL_UNCERTAIN_LO=0.45
CLASSIFY_REEL_UNCERTAIN_HI=0.65
